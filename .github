name: Envoi Graphique BTC Discord

on:
  schedule:
    # S'exécute automatiquement toutes les 30 minutes
    - cron: '*/30 * * * *'
  # Permet de tester manuellement depuis l'onglet Actions de GitHub
  workflow_dispatch:

jobs:
  send-chart:
    runs-on: ubuntu-latest
    steps:
      - name: Récupérer les fichiers du dépôt
        uses: actions/checkout@v4

      - name: Installer Playwright & Chromium
        run: |
          npm init -y
          npm install playwright
          npx playwright install chromium

      - name: Ouvrir index.html et envoyer le graphique sur Discord
        env:
          WEBHOOK_URL: ${{ secrets.DISCORD_WEBHOOK }}
        run: |
          node -e '
          const { chromium } = require("playwright");
          const path = require("path");
          (async () => {
            if (!process.env.WEBHOOK_URL) {
              console.error("Erreur: Le secret DISCORD_WEBHOOK est vide !");
              process.exit(1);
            }
            const browser = await chromium.launch();
            const page = await browser.newPage({ viewport: { width: 1280, height: 800 } });
            await page.goto("file://" + path.resolve("index.html"), { waitUntil: "networkidle" });
            
            // Attend que les données marché et le graphique soient prêts
            await page.waitForFunction(() => window.dataReady === true, { timeout: 20000 });
            await page.waitForTimeout(1000);

            // Déclenche directement l envoi avec le secret GitHub
            const sent = await page.evaluate(async (url) => {
              return await window.sendDiscordReport(false, null, url);
            }, process.env.WEBHOOK_URL);

            if (!sent) {
              console.error("Échec de l envoi vers Discord.");
              process.exit(1);
            }
            console.log("Rapport et graphique envoyés avec succès sur Discord !");
            await browser.close();
          })();
          '
